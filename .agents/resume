#!/usr/bin/env bash
set -euo pipefail

# Fast resume hook: Amp runs this after orb activation and after every wake,
# with at most ~10s before the agent continues. Nothing here installs or
# starts anything; the dev service is supervised through .amp/services.yaml.

# `alchemy dev` refuses to load without this: the admin email is the Google
# account that approves everyone else and adopts the existing collection. Fail
# early with the fix instead of letting the first `pnpm dev` die mid-thread.
if [[ -z "${NOOK_ADMIN_EMAIL:-}" ]]; then
  echo "resume: NOOK_ADMIN_EMAIL is unset." >&2
  echo "resume: export NOOK_ADMIN_EMAIL=you@example.com (the admin's Google account)," >&2
  echo "resume: or configure it in Amp project Secrets & Env Vars, then run: amp orb services ensure" >&2
  exit 1
fi

echo "resume ok: NOOK_ADMIN_EMAIL is set"
